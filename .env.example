# Credenciales de Supabase para la parte social (fase 1).
# Copia este fichero a  .env  y rellena los dos valores:
#   Supabase → tu proyecto → Project Settings → API
#
# La anon key es PÚBLICA por diseño: viaja dentro del APK. No pasa nada por que
# se vea, la seguridad son las políticas RLS de supabase/schema.sql.
# La service_role key NO se pone aquí NUNCA: esa sí es secreta.
#
# Si dejas estas variables vacías, la app compila y funciona 100% en local,
# como hasta ahora: no aparece ni el botón de cuenta.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
