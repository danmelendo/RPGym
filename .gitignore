node_modules/
dist/

# APK de reparto: es un artefacto de build (se publica en GitHub Releases)
RPGym.apk
*.apk
.DS_Store
*.log

# Capacitor / Android (artefactos de build; el proyecto android/ sí se puede versionar)
android/app/build/
android/.gradle/
android/local.properties
android/app/release/

# Firma de release: NUNCA subir la clave ni sus contraseñas al repositorio
*.keystore
*.jks
android/keystore.properties

# Credenciales de Supabase (la plantilla es .env.example)
.env

# Firebase: identifica la app, no da permisos de envío. Fuera por costumbre.
android/app/google-services.json

# Capturas y volcados de Playwright (pruebas locales)
.playwright-mcp/

# Firebase: la clave del service account es SECRETA y no se sube nunca.
# google-services.json tampoco: cada uno pone el suyo (y de él depende que el
# build active el push, ver vite.config.js).
android/app/google-services.json
android/app/*firebase-adminsdk*.json
supabase/.env.firebase
supabase/.temp/
