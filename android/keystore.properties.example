# Copia este fichero a android/keystore.properties y rellénalo con tus datos reales.
# android/keystore.properties NO se versiona (está en .gitignore): contiene contraseñas.
#
# storeFile admite ruta absoluta o relativa a la carpeta android/.
# En Windows, escribe las barras como / o escápalas como \\.

storeFile=C:/claves/rpgym.jks
storePassword=CAMBIA_ESTO
keyAlias=rpgym
keyPassword=CAMBIA_ESTO
